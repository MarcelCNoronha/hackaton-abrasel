# Template for the GitHub Actions secret `PRODUCTION_ENV_FILE` — its entire content becomes
# the VPS's docker-compose.prod.yml `.env` (used both for compose variable substitution AND
# passed into the app/queue containers via `env_file`). Fill in real values before pasting
# into the GitHub secret; never commit a filled-in version of this file.

# --- Used by docker-compose.prod.yml itself (image tag, published port) ---
IMAGE_NAME=ghcr.io/OWNER/REPO
IMAGE_TAG=latest
# Port the app's own nginx publishes on the VPS host, terminating TLS itself (see
# docker/nginx/prod.conf). Matched by a Cloudflare Origin Rule: host equals food.vicosa.tech ->
# rewrite port to APP_PORT. Must not collide with a port already used by another app/rule on
# this VPS (e.g. concilia.vicosa.tech already rewrites to 8443) — verify on the VPS before first
# deploy.
APP_PORT=8444

# --- Postgres (compose substitution) ---
DB_DATABASE=saborlocal
DB_USERNAME=saborlocal
DB_PASSWORD=CHANGE_ME

# --- Redis (compose substitution) ---
REDIS_PASSWORD=CHANGE_ME

# --- App config ---
APP_NAME=VicosaFood
APP_ENV=production
APP_KEY=CHANGE_ME_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://food.vicosa.tech

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=pgsql

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.vicosa.tech

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@vicosa.tech"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
